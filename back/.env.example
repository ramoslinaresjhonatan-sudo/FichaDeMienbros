# Producción: nunca copies secretos ni contraseñas a este archivo.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
URL_DATABASE=postgresql://user:password@host/database?sslmode=require
PORT=8000
